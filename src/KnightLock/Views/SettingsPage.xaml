<UserControl x:Class="KnightLock.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
        <StackPanel Margin="28,10,28,28" MaxWidth="880" HorizontalAlignment="Left">

            <TextBlock Text="Settings" Style="{StaticResource PageHeaderTextStyle}" />
            <TextBlock Text="Appearance, cryptographic strength and what happens to decrypted files."
                       Style="{StaticResource BodySecondaryTextStyle}" Margin="0,4,0,20" />

            <!-- ===================== Appearance ===================== -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Appearance" Style="{StaticResource SubtitleTextStyle}" FontSize="17" />
                    <TextBlock Text="Follows Windows by default, including the accent colour."
                               Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0" />

                    <TextBlock Text="App theme" Style="{StaticResource FieldLabelTextStyle}" Margin="0,18,0,6" />
                    <Border CornerRadius="6" HorizontalAlignment="Left" Padding="3"
                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ThemeSystem" GroupName="Theme" Style="{StaticResource SegmentStyle}"
                                         Content="Use system setting" Tag="System" Checked="Theme_Checked" />
                            <RadioButton x:Name="ThemeLight" GroupName="Theme" Style="{StaticResource SegmentStyle}"
                                         Content="Light" Tag="Light" Checked="Theme_Checked" />
                            <RadioButton x:Name="ThemeDark" GroupName="Theme" Style="{StaticResource SegmentStyle}"
                                         Content="Dark" Tag="Dark" Checked="Theme_Checked" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Window material" Style="{StaticResource FieldLabelTextStyle}" Margin="0,18,0,6" />
                    <Border CornerRadius="6" HorizontalAlignment="Left" Padding="3"
                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="BackdropMica" GroupName="Backdrop" Style="{StaticResource SegmentStyle}"
                                         Content="Mica" Tag="Mica" Checked="Backdrop_Checked" />
                            <RadioButton x:Name="BackdropAcrylic" GroupName="Backdrop" Style="{StaticResource SegmentStyle}"
                                         Content="Acrylic" Tag="Acrylic" Checked="Backdrop_Checked" />
                            <RadioButton x:Name="BackdropSolid" GroupName="Backdrop" Style="{StaticResource SegmentStyle}"
                                         Content="Solid" Tag="Solid" Checked="Backdrop_Checked" />
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="BackdropStatus" Text="" Style="{StaticResource CaptionTextStyle}"
                               Margin="0,8,0,0" />

                    <CheckBox x:Name="AccentToggle" Style="{StaticResource ToggleSwitchStyle}" Margin="0,16,0,0"
                              Content="Use my Windows accent colour" Click="AccentToggle_Click" />
                </StackPanel>
            </Border>

            <!-- ===================== Security ===================== -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Security" Style="{StaticResource SubtitleTextStyle}" FontSize="17" />

                    <TextBlock Text="Key derivation work factor (applies to new vaults)"
                               Style="{StaticResource FieldLabelTextStyle}" Margin="0,18,0,6" />
                    <Border CornerRadius="6" HorizontalAlignment="Left" Padding="3"
                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="IterFast" GroupName="Iter" Style="{StaticResource SegmentStyle}"
                                         Content="300,000 · fast" Tag="300000" Checked="Iterations_Checked" />
                            <RadioButton x:Name="IterRecommended" GroupName="Iter" Style="{StaticResource SegmentStyle}"
                                         Content="600,000 · recommended" Tag="600000" Checked="Iterations_Checked" />
                            <RadioButton x:Name="IterParanoid" GroupName="Iter" Style="{StaticResource SegmentStyle}"
                                         Content="1,200,000 · slower" Tag="1200000" Checked="Iterations_Checked" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="PBKDF2-HMAC-SHA256 rounds. Higher is harder to brute-force and adds about half a second to unlock."
                               Style="{StaticResource CaptionTextStyle}" Margin="0,8,0,0" />

                    <TextBlock Text="Secure wipe passes for decrypted files"
                               Style="{StaticResource FieldLabelTextStyle}" Margin="0,18,0,6" />
                    <Border CornerRadius="6" HorizontalAlignment="Left" Padding="3"
                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="Wipe1" GroupName="Wipe" Style="{StaticResource SegmentStyle}"
                                         Content="1 pass" Tag="1" Checked="Wipe_Checked" />
                            <RadioButton x:Name="Wipe2" GroupName="Wipe" Style="{StaticResource SegmentStyle}"
                                         Content="2 passes" Tag="2" Checked="Wipe_Checked" />
                            <RadioButton x:Name="Wipe3" GroupName="Wipe" Style="{StaticResource SegmentStyle}"
                                         Content="3 passes" Tag="3" Checked="Wipe_Checked" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Auto-lock unlocked vaults"
                               Style="{StaticResource FieldLabelTextStyle}" Margin="0,18,0,6" />
                    <Border CornerRadius="6" HorizontalAlignment="Left" Padding="3"
                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="AutoOff" GroupName="Auto" Style="{StaticResource SegmentStyle}"
                                         Content="Never" Tag="0" Checked="AutoLock_Checked" />
                            <RadioButton x:Name="Auto5" GroupName="Auto" Style="{StaticResource SegmentStyle}"
                                         Content="5 min" Tag="5" Checked="AutoLock_Checked" />
                            <RadioButton x:Name="Auto10" GroupName="Auto" Style="{StaticResource SegmentStyle}"
                                         Content="10 min" Tag="10" Checked="AutoLock_Checked" />
                            <RadioButton x:Name="Auto30" GroupName="Auto" Style="{StaticResource SegmentStyle}"
                                         Content="30 min" Tag="30" Checked="AutoLock_Checked" />
                        </StackPanel>
                    </Border>

                    <CheckBox x:Name="OpenExplorerToggle" Style="{StaticResource ToggleSwitchStyle}" Margin="0,18,0,0"
                              Content="Open the folder in File Explorer after unlocking" Click="Toggle_Click" />
                    <CheckBox x:Name="ConfirmToggle" Style="{StaticResource ToggleSwitchStyle}" Margin="0,10,0,0"
                              Content="Ask before locking when there are unsaved changes" Click="Toggle_Click" />
                    <CheckBox x:Name="SealOnExitToggle" Style="{StaticResource ToggleSwitchStyle}" Margin="0,10,0,0"
                              Content="Seal changes back into the vault when KnightLock closes" Click="Toggle_Click" />
                </StackPanel>
            </Border>

            <!-- ===================== Windows integration ===================== -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Windows integration" Style="{StaticResource SubtitleTextStyle}" FontSize="17" />

                    <CheckBox x:Name="AssociateToggle" Style="{StaticResource ToggleSwitchStyle}" Margin="0,18,0,0"
                              Content="Open .vault files in KnightLock when I double-click them"
                              Click="AssociateToggle_Click" />
                    <TextBlock x:Name="AssociateStatus" Text="" Style="{StaticResource CaptionTextStyle}"
                               Margin="0,8,0,0" TextWrapping="Wrap" />

                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="Open Windows Default apps" Height="32" FontSize="13" Margin="0,0,8,8"
                                Click="OpenDefaultApps_Click" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ===================== Storage & data ===================== -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Storage &amp; data" Style="{StaticResource SubtitleTextStyle}" FontSize="17" />

                    <TextBlock x:Name="LibraryCountText" Text="" Style="{StaticResource BodyTextStyle}" Margin="0,14,0,0" />
                    <TextBlock x:Name="SessionsText" Text="" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0" />
                    <TextBlock x:Name="PathsText" Text="" Style="{StaticResource CaptionTextStyle}"
                               Margin="0,10,0,0" FontFamily="{StaticResource FontFamilyMono}" />

                    <WrapPanel Margin="0,14,0,0">
                        <Button Content="Open app data folder" Margin="0,0,8,8" Height="32" FontSize="13"
                                Click="OpenAppData_Click" />
                        <Button Content="Open session folder" Margin="0,0,8,8" Height="32" FontSize="13"
                                Click="OpenSessions_Click" />
                        <Button Content="Remove missing vaults" Margin="0,0,8,8" Height="32" FontSize="13"
                                Click="Prune_Click" />
                        <Button Content="Wipe decrypted sessions now" Margin="0,0,8,8" Height="32" FontSize="13"
                                Click="WipeSessions_Click" />
                        <Button Content="Forget all vaults" Margin="0,0,8,8" Height="32" FontSize="13"
                                Click="Forget_Click" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ===================== About ===================== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Source="Assets/KnightLock-96.png" Width="44" Height="44"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="KnightLock" Style="{StaticResource BodyStrongTextStyle}" FontSize="16" />
                            <TextBlock x:Name="VersionInfoText" Text="" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="EngineInfoText" Text="" Style="{StaticResource CaptionTextStyle}"
                               Margin="0,14,0,0" FontFamily="{StaticResource FontFamilyMono}" LineHeight="19" />

                    <TextBlock Text="No telemetry. No cloud. No network access at all — KnightLock never connects to the internet."
                               Style="{StaticResource CaptionTextStyle}" Margin="0,14,0,0" />

                    <WrapPanel Margin="0,14,0,0">
                        <Button Content="Open log file" Margin="0,0,8,0" Height="32" FontSize="13"
                                Click="OpenLog_Click" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
