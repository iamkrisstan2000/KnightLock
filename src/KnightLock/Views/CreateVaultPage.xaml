<UserControl x:Class="KnightLock.Views.CreateVaultPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:KnightLock.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
        <StackPanel Margin="28,10,28,28" MaxWidth="880" HorizontalAlignment="Left">

            <!-- Header -->
            <TextBlock Text="Create Vault" Style="{StaticResource PageHeaderTextStyle}" />
            <TextBlock Text="KnightLock compresses a folder into a single encrypted container. The original folder is left untouched unless you ask otherwise."
                       Style="{StaticResource BodySecondaryTextStyle}" Margin="0,4,0,20" MaxWidth="720"
                       TextWrapping="Wrap" />

            <!-- ===================== Step 1: source ===================== -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="22" Height="22" CornerRadius="11"
                                Background="{DynamicResource AccentFillColorDefaultBrush}">
                            <TextBlock Text="1" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Choose what to lock" Style="{StaticResource SectionHeaderTextStyle}"
                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="Source folder" Style="{StaticResource FieldLabelTextStyle}" Margin="0,16,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <controls:PathField x:Name="SourceField"
                                            Placeholder="No folder selected yet" />
                        <Button Grid.Column="1" Content="Browse…" Width="96" Height="34" Margin="8,0,0,0"
                                Click="BrowseSource_Click" />
                    </Grid>

                    <TextBlock x:Name="SourceSummary" Text="" Style="{StaticResource CaptionTextStyle}"
                               Margin="0,8,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- ===================== Step 2: destination ===================== -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="22" Height="22" CornerRadius="11"
                                Background="{DynamicResource AccentFillColorDefaultBrush}">
                            <TextBlock Text="2" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Where to keep the vault file" Style="{StaticResource SectionHeaderTextStyle}"
                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="Vault container (.vault)" Style="{StaticResource FieldLabelTextStyle}" Margin="0,16,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <controls:PathField x:Name="DestinationField"
                                            Icon="{StaticResource GeoLock}"
                                            Placeholder="Pick a location for the .vault file" />
                        <Button Grid.Column="1" Content="Save as…" Width="104" Height="34" Margin="8,0,0,0"
                                Click="BrowseDestination_Click" />
                    </Grid>
                    <TextBlock Text="Keep the container on a drive with enough free space — it is roughly the size of the compressed folder."
                               Style="{StaticResource CaptionTextStyle}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- ===================== Step 3: password ===================== -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="22" Height="22" CornerRadius="11"
                                Background="{DynamicResource AccentFillColorDefaultBrush}">
                            <TextBlock Text="3" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Set a master password" Style="{StaticResource SectionHeaderTextStyle}"
                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Master password" Style="{StaticResource FieldLabelTextStyle}" />
                            <controls:SecretInput x:Name="PasswordBox" Placeholder="At least 8 characters"
                                                  PasswordChanged="PasswordBox_PasswordChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Confirm password" Style="{StaticResource FieldLabelTextStyle}" />
                            <controls:SecretInput x:Name="ConfirmBox" Placeholder="Type it again"
                                                  PasswordChanged="PasswordBox_PasswordChanged" />
                        </StackPanel>
                    </Grid>

                    <!-- Strength meter -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Height="4" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Seg1" Grid.Column="0" CornerRadius="2" Margin="0,0,3,0"
                                    Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
                            <Border x:Name="Seg2" Grid.Column="1" CornerRadius="2" Margin="0,0,3,0"
                                    Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
                            <Border x:Name="Seg3" Grid.Column="2" CornerRadius="2" Margin="0,0,3,0"
                                    Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
                            <Border x:Name="Seg4" Grid.Column="3" CornerRadius="2" Margin="0,0,3,0"
                                    Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
                            <Border x:Name="Seg5" Grid.Column="4" CornerRadius="2"
                                    Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
                        </Grid>
                        <TextBlock x:Name="StrengthLabel" Grid.Column="1" Text="" FontSize="12"
                                   Margin="12,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>

                    <TextBlock x:Name="StrengthHint" Text="" Style="{StaticResource CaptionTextStyle}"
                               Margin="0,8,0,0" />

                    <!-- No-recovery warning -->
                    <Border CornerRadius="6" Padding="12" Margin="0,14,0,0"
                            Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:IconPresenter Style="{StaticResource IconWarningStyle}"
                                                    Width="15" Height="15" VerticalAlignment="Top" Margin="0,2,0,0"
                                                    Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                            <TextBlock Grid.Column="1" Margin="10,0,0,0" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Text="There is no password recovery. KnightLock stores no key anywhere — if this password is lost, the data inside the vault cannot be decrypted by anyone, including you." />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ===================== Step 4: options ===================== -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Options" Style="{StaticResource SectionHeaderTextStyle}" />
                    <CheckBox x:Name="ShredSourceCheck"
                              Style="{StaticResource ToggleSwitchStyle}"
                              Margin="0,12,0,0"
                              Content="Securely wipe the source folder after the vault is created" />
                    <TextBlock Text="Deletes the original files with a random-data overwrite. Only enable this once you have verified the vault opens correctly."
                               Style="{StaticResource CaptionTextStyle}" Margin="52,2,0,0" />
                </StackPanel>
            </Border>

            <!-- ===================== Actions ===================== -->
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="EngineText" Style="{StaticResource CaptionTextStyle}"
                           VerticalAlignment="Center" Text="" />

                <Button Grid.Column="1" Content="Reset" MinWidth="88" Height="36" Margin="0,0,8,0"
                        Click="Reset_Click" />

                <Button x:Name="CreateButton" Grid.Column="2" Height="36" MinWidth="150"
                        Style="{StaticResource AccentButtonStyle}" Click="Create_Click">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <controls:IconPresenter Style="{StaticResource IconLockStyle}" Width="15" Height="15" />
                            <TextBlock Text="Create vault" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button.Content>
                </Button>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
