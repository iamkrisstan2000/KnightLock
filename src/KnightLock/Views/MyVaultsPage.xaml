<UserControl x:Class="KnightLock.Views.MyVaultsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:KnightLock.Controls">

    <Grid Margin="28,10,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================ Header ============================ -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="My Vaults" Style="{StaticResource PageHeaderTextStyle}" />
                <TextBlock x:Name="SubtitleText"
                           Text="Unlock a vault to work with its files. Everything is sealed again when you lock it."
                           Style="{StaticResource BodySecondaryTextStyle}" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,4,0,0">
                <Button Content="Browse for .vault…" Height="34" Margin="0,0,8,0" Click="Browse_Click"
                        ToolTip="Add an existing KnightLock container to your library" />
                <Button Height="34" Style="{StaticResource AccentButtonStyle}"
                        Click="NewVault_Click">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <controls:IconPresenter Style="{StaticResource IconPlusStyle}" Width="14" Height="14" />
                            <TextBlock Text="New vault" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button.Content>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============================ Body ============================ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <!-- Vault list -->
            <Grid Grid.Column="0">
                <ScrollViewer x:Name="ListScroller" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                    <ItemsControl x:Name="VaultList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="14" Margin="0,0,0,10" CornerRadius="8" BorderThickness="1"
                                        Tag="{Binding}" Cursor="Hand" MouseLeftButtonUp="Card_Click">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="40" Height="40" CornerRadius="8" VerticalAlignment="Top"
                                                Background="{DynamicResource BrandTintBrush}">
                                            <controls:IconPresenter Width="20" Height="20"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}">
                                                <controls:IconPresenter.Style>
                                                    <Style TargetType="controls:IconPresenter"
                                                           BasedOn="{StaticResource IconLockStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                                                                <Setter Property="Data" Value="{StaticResource GeoUnlock}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </controls:IconPresenter.Style>
                                            </controls:IconPresenter>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongTextStyle}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Path}" Style="{StaticResource CaptionTextStyle}"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding MetaText}" Style="{StaticResource CaptionTextStyle}"
                                                       Margin="0,6,0,0" />
                                        </StackPanel>

                                        <Border Grid.Column="2" CornerRadius="4" Padding="8,3" VerticalAlignment="Top">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty state -->
                <Border x:Name="EmptyState" Visibility="Collapsed" CornerRadius="8" BorderThickness="1"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                        Padding="40" VerticalAlignment="Top">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="72" Height="72" CornerRadius="36" HorizontalAlignment="Center"
                                Background="{DynamicResource BrandTintBrush}">
                            <controls:IconPresenter Style="{StaticResource IconFolderStyle}" Width="34" Height="34"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        </Border>
                        <TextBlock Text="No vaults yet" Style="{StaticResource SubtitleTextStyle}"
                                   HorizontalAlignment="Center" Margin="0,18,0,0" />
                        <TextBlock Text="Lock a folder into an encrypted container and it will appear here."
                                   Style="{StaticResource BodySecondaryTextStyle}" TextAlignment="Center"
                                   MaxWidth="360" Margin="0,8,0,0" HorizontalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                            <Button Content="Create your first vault" Style="{StaticResource AccentButtonStyle}"
                                    Click="NewVault_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Detail pane -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0" VerticalAlignment="Top">
                <Grid>
                    <!-- Nothing selected -->
                    <StackPanel x:Name="DetailEmpty" Margin="24,44,24,44" HorizontalAlignment="Center">
                        <controls:IconPresenter Style="{StaticResource IconLockStyle}" Width="30" Height="30"
                                                HorizontalAlignment="Center"
                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="Select a vault" Style="{StaticResource BodyStrongTextStyle}"
                                   HorizontalAlignment="Center" Margin="0,12,0,0" />
                        <TextBlock Text="Pick a vault on the left to unlock it, or browse for a .vault file."
                                   Style="{StaticResource CaptionTextStyle}" TextAlignment="Center"
                                   MaxWidth="260" Margin="0,6,0,0" />
                    </StackPanel>

                    <!-- Selected vault -->
                    <StackPanel x:Name="DetailPanel" Visibility="Collapsed" Margin="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" CornerRadius="9" VerticalAlignment="Top"
                                    Background="{DynamicResource BrandTintBrush}">
                                <controls:IconPresenter x:Name="DetailGlyph" Style="{StaticResource IconLockStyle}"
                                                        Width="22" Height="22"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                <TextBlock x:Name="DetailName" Text="Vault" Style="{StaticResource SubtitleTextStyle}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="DetailPath" Text="" Style="{StaticResource CaptionTextStyle}"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- Facts -->
                        <Border Style="{StaticResource InsetCardStyle}" Margin="0,18,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="Container size" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock x:Name="DetailSize" Text="—" Style="{StaticResource BodyStrongTextStyle}"
                                               FontSize="13" Margin="0,1,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1">
                                    <TextBlock Text="Files inside" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock x:Name="DetailFiles" Text="—" Style="{StaticResource BodyStrongTextStyle}"
                                               FontSize="13" Margin="0,1,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,0,0">
                                    <TextBlock Text="Created" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock x:Name="DetailCreated" Text="—" Style="{StaticResource BodyStrongTextStyle}"
                                               FontSize="13" Margin="0,1,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,12,0,0">
                                    <TextBlock Text="Last opened" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock x:Name="DetailOpened" Text="—" Style="{StaticResource BodyStrongTextStyle}"
                                               FontSize="13" Margin="0,1,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Locked: unlock form -->
                        <StackPanel x:Name="LockedPanel" Margin="0,20,0,0">
                            <TextBlock Text="Master password" Style="{StaticResource FieldLabelTextStyle}" />
                            <controls:SecretInput x:Name="DetailPassword" Placeholder="Enter master password"
                                                  Submitted="DetailPassword_Submitted"
                                                  PasswordChanged="DetailPassword_PasswordChanged" />
                            <TextBlock x:Name="PasswordHint" Text="" Style="{StaticResource CaptionTextStyle}"
                                       Margin="0,6,0,0" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                       Visibility="Collapsed" />

                            <Button x:Name="UnlockButton" Margin="0,14,0,0" Height="36"
                                    Style="{StaticResource AccentButtonStyle}" Click="Unlock_Click">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <controls:IconPresenter Style="{StaticResource IconUnlockStyle}"
                                                                Width="15" Height="15" />
                                        <TextBlock Text="Unlock vault" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button.Content>
                            </Button>

                            <TextBlock Text="Files are decrypted into a private temporary folder under %LOCALAPPDATA%\KnightLock and wiped when you lock the vault."
                                       Style="{StaticResource CaptionTextStyle}" Margin="0,12,0,0" />
                        </StackPanel>

                        <!-- Unlocked: open / lock -->
                        <StackPanel x:Name="UnlockedPanel" Margin="0,20,0,0" Visibility="Collapsed">
                            <Border CornerRadius="6" Padding="12"
                                    Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <controls:IconPresenter Style="{StaticResource IconUnlockStyle}"
                                                            Width="15" Height="15" VerticalAlignment="Center"
                                                            Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                                    <TextBlock x:Name="UnlockedText" Text="This vault is unlocked."
                                               Margin="10,0,0,0" FontSize="13" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                               TextWrapping="Wrap" MaxWidth="280" />
                                </StackPanel>
                            </Border>

                            <Button Margin="0,14,0,0" Height="36"
                                    Click="OpenFolder_Click">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <controls:IconPresenter Style="{StaticResource IconFolderOpenStyle}"
                                                                Width="15" Height="15" />
                                        <TextBlock Text="Open in File Explorer" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button.Content>
                            </Button>

                            <Button x:Name="LockButton" Margin="0,8,0,0" Height="36"
                                    Style="{StaticResource AccentButtonStyle}" Click="Lock_Click">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <controls:IconPresenter Style="{StaticResource IconLockStyle}"
                                                                Width="15" Height="15" />
                                        <TextBlock Text="Lock vault" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button.Content>
                            </Button>

                            <TextBlock x:Name="ChangesText" Text="" Style="{StaticResource CaptionTextStyle}"
                                       Margin="0,12,0,0" />
                        </StackPanel>

                        <Separator Margin="0,18,0,12" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                        <Button Content="Remove from library" Style="{StaticResource SubtleButtonStyle}"
                                HorizontalAlignment="Left" FontSize="13" Height="28"
                                ToolTip="Only forgets this entry — the .vault file is not deleted"
                                Click="RemoveFromLibrary_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
