<Window x:Class="KnightLock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:KnightLock.Controls"
        xmlns:conv="clr-namespace:KnightLock.Converters"
        Title="KnightLock"
        Width="1180" Height="780"
        MinWidth="940" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="CanResize"
        Icon="Assets/KnightLock.ico"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource FontFamilyBody}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <WindowChrome.WindowChrome>
        <!--
            Custom title bar, DWM-drawn resize border, Mica-friendly glass frame.

            WindowStyle="None" is what actually guarantees a single set of caption buttons: with
            the default SingleBorderWindow style the DWM still paints its own caption over the
            non-client frame, so the OS glyphs and the ones below both showed up. WindowStyle
            None hands the whole window to WPF while WindowChrome keeps the resize border, the
            drop shadow and Aero snap.
        -->
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="-1"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!--
        Shell geometry (measured off the reference design):

        ┌───────────────────────────────────────────────┐
        │ titlebar band 42 px   [brand]  [–  ▢  ✕]      │  chrome surface
        ├──────┬────────────────────────────────────────┤
        │ rail │  content well                          │  well: rounded top-left corner,
        │ 48 px│  (lighter layer, flush right/bottom)   │  flush to the right and bottom edges
        └──────┴────────────────────────────────────────┘

        The band and the rail share one brush so they read as a single surface; the well is the
        separate surface that holds the page.
    -->
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavColumn" Width="48" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- =====================================================================
             Titlebar band — brand on the left, window controls on the right.
             ===================================================================== -->
        <Border x:Name="TitleBarBand" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                Background="{DynamicResource NavigationFillBrush}">
            <Grid Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="BrandStack" Grid.Column="0" Orientation="Horizontal"
                            Margin="16,0,12,0" VerticalAlignment="Center">
                    <Image Source="Assets/KnightLock-48.png" Width="18" Height="18"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="BrandText" Text="KnightLock" Margin="9,0,0,0"
                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border x:Name="BrandChip" Margin="10,0,0,0" Padding="6,2" CornerRadius="4"
                            VerticalAlignment="Center"
                            Background="{DynamicResource BrandTintBrush}">
                        <TextBlock Text="ENCRYPTED" FontSize="9" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
                    <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButtonStyle}"
                            ToolTip="Minimize" Click="Minimize_Click">
                        <controls:IconPresenter Style="{StaticResource IconMinimizeStyle}" />
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButtonStyle}"
                            ToolTip="Maximize" Click="Maximize_Click">
                        <controls:IconPresenter x:Name="MaximizeGlyph" Style="{StaticResource IconMaximizeStyle}" />
                    </Button>
                    <Button x:Name="CloseAppButton" Style="{StaticResource CloseCaptionButtonStyle}"
                            ToolTip="Close" Click="Close_Click">
                        <controls:IconPresenter Style="{StaticResource IconCloseStyle}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- =====================================================================
             Left rail — icon-only by default, expands into the labelled pane.
             ===================================================================== -->
        <Border x:Name="NavPane" Grid.Row="1" Grid.Column="0"
                Background="{DynamicResource NavigationFillBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Button x:Name="HamburgerButton" Grid.Row="0" Style="{StaticResource IconButtonStyle}"
                        Width="40" Height="40" MinWidth="40"
                        Margin="4,6,4,2" HorizontalAlignment="Center"
                        ToolTip="Expand navigation" Click="ToggleNav_Click">
                    <controls:IconPresenter Style="{StaticResource IconMenuStyle}" Width="16" Height="16" />
                </Button>

                <!-- Primary destinations -->
                <StackPanel x:Name="NavItemsPanel" Grid.Row="1" Margin="4,0,4,0">
                    <RadioButton x:Name="NavMyVaults" GroupName="MainNav" Style="{StaticResource NavItemStyle}"
                                 Tag="{StaticResource GeoFolder}" Content="" IsChecked="True"
                                 Checked="Nav_Checked" />
                    <RadioButton x:Name="NavCreateVault" GroupName="MainNav" Style="{StaticResource NavItemStyle}"
                                 Tag="{StaticResource GeoPlus}" Content="" Checked="Nav_Checked" />
                </StackPanel>

                <!-- Rail-only chrome: session state above a hairline divider, as in the reference -->
                <Button x:Name="RailLockButton" Grid.Row="3" Style="{StaticResource IconButtonStyle}"
                        Width="32" Height="32" MinWidth="32"
                        Margin="0,0,0,2" HorizontalAlignment="Center"
                        Background="Transparent" BorderThickness="0"
                        IsEnabled="False"
                        ToolTip="All vaults locked" Click="LockAll_Click">
                    <controls:IconPresenter x:Name="RailLockGlyph" Style="{StaticResource IconLockStyle}"
                                            Width="15" Height="15" />
                </Button>

                <Rectangle x:Name="RailDivider" Grid.Row="4" Height="1" Width="20"
                           Margin="0,6,0,8" HorizontalAlignment="Center"
                           Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />

                <!-- Expanded-only session card (sits above Settings, mirroring the rail order) -->
                <Border x:Name="PaneFooter" Grid.Row="5" Margin="12,0,12,10" Padding="12" CornerRadius="8"
                        Visibility="Collapsed"
                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <controls:IconPresenter x:Name="UnlockedBadge" Style="{StaticResource IconLockStyle}"
                                                    Width="13" Height="13"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock x:Name="SessionStatusText" Text="All vaults locked"
                                       Margin="8,0,0,0" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <Button x:Name="LockAllButton" Content="Lock all vaults"
                                Margin="0,10,0,0" Height="30" FontSize="12"
                                IsEnabled="False" Click="LockAll_Click" />

                        <TextBlock x:Name="VersionText" Text="v1.0.0 · AES-256-GCM"
                                   Margin="0,10,0,0" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Settings is always the last thing in the pane: below the lock, rail or expanded -->
                <RadioButton x:Name="NavSettings" Grid.Row="6" GroupName="MainNav"
                             Style="{StaticResource NavItemStyle}" Margin="4,0,4,6"
                             Tag="{StaticResource GeoGear}" Content="" Checked="Nav_Checked" />
            </Grid>
        </Border>

        <!-- =====================================================================
             Content well — the separate page surface.
             ===================================================================== -->
        <!--
            Notch filler — sits directly beneath the well and has the exact shape the well's
            rounded corner cuts away. It is transparent except under Acrylic (see
            ApplyThemeToWindow), where the bare cut-out is a hole through to the wallpaper and
            read as a bright spur brighter than either surface.
        -->
        <Path x:Name="WellCornerNotch" Grid.Row="1" Grid.Column="1"
              Width="10" Height="10" Stretch="None"
              HorizontalAlignment="Left" VerticalAlignment="Top"
              IsHitTestVisible="False"
              Data="{x:Static conv:WellGeometry.CornerNotch}"
              Fill="Transparent" />

        <Border x:Name="ContentWell" Grid.Row="1" Grid.Column="1"
                Background="{DynamicResource LayerFillColorDefaultBrush}">
            <!--
                The well's shape is defined by this clip alone — CornerRadius is deliberately 0.
                Rounding the border *and* clipping it meant two anti-aliased edges on the same arc;
                the partial alphas multiplied, the surface went slightly transparent along the
                corner, and the bright Acrylic backdrop showed through as a thin seam (invisible
                over Mica/Solid). One geometry, one anti-aliased edge.
            -->
            <Border.Clip>
                <MultiBinding Converter="{StaticResource RoundedTopLeftClip}" ConverterParameter="10">
                    <Binding Path="ActualWidth" ElementName="ContentWell" />
                    <Binding Path="ActualHeight" ElementName="ContentWell" />
                </MultiBinding>
            </Border.Clip>
            <ContentControl x:Name="PageHost" />
        </Border>

        <!-- ContentDialog + progress overlay, above every surface including the chrome -->
        <controls:ContentDialogHost x:Name="DialogLayer" Grid.Row="0" Grid.RowSpan="2"
                                    Grid.Column="0" Grid.ColumnSpan="2"
                                    Panel.ZIndex="1000" />
    </Grid>
</Window>
