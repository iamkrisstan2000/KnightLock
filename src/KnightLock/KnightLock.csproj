<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>

    <AssemblyName>KnightLock</AssemblyName>
    <RootNamespace>KnightLock</RootNamespace>
    <ApplicationIcon>Assets\KnightLock.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Product>KnightLock</Product>
    <AssemblyTitle>KnightLock — Encrypted File Vault</AssemblyTitle>
    <Company>KnightWin</Company>
    <Description>KnightLock is a native Windows 11 encrypted file vault (AES-256-GCM).</Description>
    <Copyright>Copyright © 2026 KnightWin</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>

    <!-- Cross-compilation / publishing -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Runtime tuning for a desktop app.

    Workstation, concurrent GC: this is a single-window UI process, so the server GC's per-core
    heaps would reserve memory we can never use. Concurrent collection keeps the UI honest while
    the vaule engine churns through 64 KB crypto chunks, and it is the combination that keeps the
    resident set flat over a long session.

    Tiered compilation + PGO is the default on .NET 8, but it is spelled out here because the
    single-file publish settings would otherwise be the only runtime knobs visible in this file.
    The unsafe/legacy switches are turned off explicitly: none of them is reachable from this code
    and leaving them on only widens the attack surface.
  -->
  <PropertyGroup>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
    <TieredCompilation>true</TieredCompilation>
    <TieredPGO>true</TieredPGO>
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
    <DebuggerSupport>false</DebuggerSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
    <EnableUnsafeUTF7Encoding>false</EnableUnsafeUTF7Encoding>
  </PropertyGroup>

  <!--
    Only the artwork the app actually draws is embedded: the .ico for the shell, the 48 px mark for
    the title bar and the 96 px mark for Settings. Larger sizes live in icon-source.png and are
    regenerated by Assets/build-icon.py instead of being compiled into the exe.
  -->
  <ItemGroup>
    <Resource Include="Assets\KnightLock.ico" />
    <Resource Include="Assets\KnightLock-96.png" />
    <Resource Include="Assets\KnightLock-48.png" />
  </ItemGroup>

</Project>
