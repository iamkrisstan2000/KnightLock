<UserControl x:Class="KnightLock.Controls.SecretInput"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:KnightLock.Controls"
             x:Name="Root">
    <!--
        One field surface: the rounded chrome belongs to the control, the masked/revealed inputs are
        chromeless inside it, and the reveal toggle sits inside the field's right edge (as in WinUI)
        instead of floating next to it.
    -->
    <Border x:Name="Chrome" Height="34" CornerRadius="5" BorderThickness="1"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                    </Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ControlFillColorInputActiveBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid Margin="11,0,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Masked -->
                <PasswordBox x:Name="Masked"
                             Style="{StaticResource EmbeddedPasswordBoxStyle}"
                             PasswordChanged="Masked_PasswordChanged"
                             KeyDown="Input_KeyDown" />

                <!-- Revealed -->
                <TextBox x:Name="Revealed"
                         Style="{StaticResource EmbeddedTextBoxStyle}"
                         Visibility="Collapsed"
                         TextChanged="Revealed_TextChanged"
                         KeyDown="Input_KeyDown" />

                <Button x:Name="RevealButton"
                        Grid.Column="1"
                        Style="{StaticResource SubtleButtonStyle}"
                        Width="28" Height="28"
                        MinWidth="0" MinHeight="0"
                        Padding="0"
                        Margin="2,0,0,0"
                        VerticalAlignment="Center"
                        ToolTip="Show password"
                        Click="RevealButton_Click"
                        AutomationProperties.Name="Show password">
                    <controls:IconPresenter x:Name="RevealGlyph"
                                            Data="{StaticResource GeoEye}"
                                            Width="16" Height="16" />
                </Button>
            </Grid>

            <!-- Accent underline, shown only while the field has focus -->
            <Rectangle x:Name="FocusLine" Height="2" RadiusX="1" RadiusY="1"
                       Margin="2,0,2,1" VerticalAlignment="Bottom"
                       Fill="{DynamicResource AccentFillColorDefaultBrush}"
                       Visibility="Collapsed" />
        </Grid>
    </Border>
</UserControl>
