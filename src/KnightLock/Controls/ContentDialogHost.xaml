<UserControl x:Class="KnightLock.Controls.ContentDialogHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:KnightLock.Controls"
             Panel.ZIndex="9000">

    <Grid x:Name="LayerRoot" Visibility="Collapsed">

        <!-- Scrim -->
        <Border x:Name="Scrim" Background="{DynamicResource SmokeBrush}" Opacity="0" />

        <!-- ===================== Dialog card ===================== -->
        <Border x:Name="DialogCard"
                Width="460"
                MaxWidth="560"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource DialogSurfaceBrush}"
                BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="24"
                Opacity="0"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.34" Color="#000000" />
            </Border.Effect>

            <StackPanel>
                <!-- Title row -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="GlyphBadge" Width="32" Height="32" CornerRadius="16"
                            Background="{DynamicResource BrandTintBrush}" VerticalAlignment="Top">
                        <controls:IconPresenter x:Name="GlyphIcon" Style="{StaticResource IconBaseStyle}"
                                                Width="17" Height="17"
                                                Data="{StaticResource GeoInfo}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    </Border>
                    <TextBlock x:Name="TitleText" Grid.Column="1" Margin="12,3,0,0"
                               Style="{StaticResource SubtitleTextStyle}"
                               Text="Message" />
                </Grid>

                <TextBlock x:Name="MessageText"
                           Style="{StaticResource BodySecondaryTextStyle}"
                           Margin="44,0,0,0"
                           Text=""
                           MaxHeight="280" />

                <!-- Extra slot (e.g. a list of warnings) -->
                <ContentPresenter x:Name="ExtraContent" Margin="44,10,0,0" />

                <!-- Buttons -->
                <Grid Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="SecondaryButton" Grid.Column="1"
                            Content="Secondary"
                            MinWidth="96"
                            Margin="0,0,8,0"
                            Visibility="Collapsed"
                            Click="Secondary_Click" />

                    <Button x:Name="CloseButton" Grid.Column="2"
                            Style="{StaticResource SubtleButtonStyle}"
                            Content="Cancel"
                            MinWidth="88"
                            Margin="0,0,8,0"
                            Click="Close_Click" />

                    <Button x:Name="PrimaryButton" Grid.Column="3"
                            Style="{StaticResource AccentButtonStyle}"
                            Content="OK"
                            MinWidth="104"
                            IsDefault="True"
                            Click="Primary_Click" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- ===================== Busy card ===================== -->
        <Border x:Name="BusyCard"
                Width="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource DialogSurfaceBrush}"
                BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="26"
                Visibility="Collapsed"
                Opacity="0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.34" Color="#000000" />
            </Border.Effect>
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:ProgressRing x:Name="BusyRing" Width="36" Height="36"
                                           Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="BusyTitle" Style="{StaticResource BodyStrongTextStyle}" Text="Working…" />
                        <TextBlock x:Name="BusyMessage" Style="{StaticResource CaptionTextStyle}"
                                   Margin="0,3,0,0" Text="" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <ProgressBar x:Name="BusyBar" Margin="0,18,0,0" IsIndeterminate="True" Visibility="Collapsed" />

                <Grid Margin="0,8,0,0">
                    <TextBlock x:Name="BusyPercent" Style="{StaticResource CaptionTextStyle}" Text="" />
                    <Button x:Name="BusyCancel" HorizontalAlignment="Right"
                            Style="{StaticResource SubtleButtonStyle}"
                            Content="Cancel"
                            MinWidth="72" Height="26" FontSize="12"
                            Visibility="Collapsed"
                            Click="BusyCancel_Click" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
