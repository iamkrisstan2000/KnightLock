<?xml version="1.0" encoding="utf-8"?>
<!-- KnightLock — Fluent Design palette (Dark) -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Text -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush"       Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush"     Color="#C5FFFFFF" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush"      Color="#87FFFFFF" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush"  Color="#FF000000" />

    <!-- Accent -->
    <Color x:Key="AccentColor">#60CDFF</Color>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush"   Color="#FF60CDFF" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E660CDFF" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF99EBFF" />

    <!-- Cards & layers -->
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush"    Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush"  Color="#08FFFFFF" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush"            Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush"             Color="#4D3A3A3A" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush"  Color="#282828" />

    <!-- Controls -->
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush"    Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush"  Color="#15FFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush"   Color="#08FFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush"  Color="#12FFFFFF" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="ControlStrokeColorOnAccentDefaultBrush" Color="#14000000" />

    <!-- Subtle -->
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush"   Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush"    Color="#0AFFFFFF" />

    <!-- Lines -->
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush"  Color="#15FFFFFF" />
    <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush"  Color="#757575" />
    <SolidColorBrush x:Key="FocusStrokeColorOuterBrush"      Color="#FFFFFFFF" />

    <!-- System status -->
    <SolidColorBrush x:Key="SystemFillColorSuccessBrush"            Color="#FF6CCB5F" />
    <SolidColorBrush x:Key="SystemFillColorSuccessBackgroundBrush"  Color="#FF0F2D0F" />
    <SolidColorBrush x:Key="SystemFillColorCautionBrush"            Color="#FFFCE100" />
    <SolidColorBrush x:Key="SystemFillColorCautionBackgroundBrush"  Color="#FF433519" />
    <SolidColorBrush x:Key="SystemFillColorCriticalBrush"           Color="#FFFF99A4" />

    <!-- Shell surfaces -->
    <SolidColorBrush x:Key="ShellBackdropBrush"       Color="#202020" />
    <!-- 3% wash over the system acrylic, which reads slightly too translucent on bright wallpapers -->
    <SolidColorBrush x:Key="AcrylicVeilBrush" Color="#08000000" />
    <SolidColorBrush x:Key="NavigationFillBrush"      Color="#40202020" />
    <SolidColorBrush x:Key="SmokeBrush"               Color="#66000000" />
    <SolidColorBrush x:Key="DialogSurfaceBrush"       Color="#FF2C2C2C" />

    <!-- Brand -->
    <SolidColorBrush x:Key="BrandTintBrush" Color="#2660CDFF" />

</ResourceDictionary>
