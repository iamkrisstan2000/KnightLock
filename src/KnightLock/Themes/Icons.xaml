    <StreamGeometry x:Key="GeoWarning">F0 M12,3.1 L22.4,20.6 A0.9,0.9 0 0 1 21.6,22 H2.4 A0.9,0.9 0 0 1 1.6,20.6 Z M10.85,8.6 H13.15 L12.85,15.2 H11.15 Z M10.8,16.6 H13.2 V19 H10.8 Z</StreamGeometry>

