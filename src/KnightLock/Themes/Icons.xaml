    <!--
        Eye / eye-off, used by the reveal toggle in SecretInput.
        Filled with the NON-ZERO rule (F1): the inner almond is wound against the outer one so the
        eye stays an outline, and the slash merges with it instead of punching notches through it
        the way even-odd would.
    -->
    <StreamGeometry x:Key="GeoEye">F1 M12,4.9 C17.5,4.9 21.9,8.3 23,12 C21.9,15.7 17.5,19.1 12,19.1 C6.5,19.1 2.1,15.7 1,12 C2.1,8.3 6.5,4.9 12,4.9 Z M12,7.3 C7.7,7.3 4.2,9.5 2.6,12 C4.2,14.5 7.7,16.7 12,16.7 C16.3,16.7 19.8,14.5 21.4,12 C19.8,9.5 16.3,7.3 12,7.3 Z M12,8.9 A3.1,3.1 0 1 0 12,15.1 A3.1,3.1 0 1 0 12,8.9 Z</StreamGeometry>

    <StreamGeometry x:Key="GeoEyeOff">F1 M12,4.9 C17.5,4.9 21.9,8.3 23,12 C21.9,15.7 17.5,19.1 12,19.1 C6.5,19.1 2.1,15.7 1,12 C2.1,8.3 6.5,4.9 12,4.9 Z M12,7.3 C7.7,7.3 4.2,9.5 2.6,12 C4.2,14.5 7.7,16.7 12,16.7 C16.3,16.7 19.8,14.5 21.4,12 C19.8,9.5 16.3,7.3 12,7.3 Z M12,8.9 A3.1,3.1 0 1 0 12,15.1 A3.1,3.1 0 1 0 12,8.9 Z M4.2,2.2 L21.8,19.8 L20.4,21.2 L2.8,3.6 Z</StreamGeometry>

    <!-- ============================== icon styles ============================== -->
    <Style x:Key="IconBaseStyle" TargetType="controls:IconPresenter">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="IconFolderStyle" TargetType="controls:IconPresenter" BasedOn="{StaticResource IconBaseStyle}">
        <Setter Property="Data" Value="{StaticResource GeoFolder}" />
    </Style>

    <Style x:Key="IconFolderOpenStyle" TargetType="controls:IconPresenter" BasedOn="{StaticResource IconBaseStyle}">
        <Setter Property="Data" Value="{StaticResource GeoFolderOpen}" />
    </Style>

    <Style x:Key="IconPlusStyle" TargetType="controls:IconPresenter" BasedOn="{StaticResource IconBaseStyle}">
        <Setter Property="Data" Value="{StaticResource GeoPlus}" />
    </Style>

    <Style x:Key="IconLockStyle" TargetType="controls:IconPresenter" BasedOn="{StaticResource IconBaseStyle}">
        <Setter Property="Data" Value="{StaticResource GeoLock}" />
    </Style>

    <Style x:Key="IconUnlockStyle" TargetType="controls:IconPresenter" BasedOn="{StaticResource IconBaseStyle}">
        <Setter Property="Data" Value="{StaticResource GeoUnlock}" />
    </Style>

    <Style x:Key="IconMenuStyle" TargetType="controls:IconPresenter" BasedOn="{StaticResource IconBaseStyle}">
        <Setter Property="Data" Value="{StaticResource GeoMenu}" />
    </Style>

    <Style x:Key="IconMinimizeStyle" TargetType="controls:IconPresenter" BasedOn="{StaticResource IconBaseStyle}">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Data" Value="{StaticResource GeoMinimize}" />
    </Style>

    <Style x:Key="IconMaximizeStyle" TargetType="controls:IconPresenter" BasedOn="{StaticResource IconBaseStyle}">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Data" Value="{StaticResource GeoMaximize}" />
    </Style>

    <Style x:Key="IconCloseStyle" TargetType="controls:IconPresenter" BasedOn="{StaticResource IconBaseStyle}">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Data" Value="{StaticResource GeoClose}" />
    </Style>

    <Style x:Key="IconWarningStyle" TargetType="controls:IconPresenter" BasedOn="{StaticResource IconBaseStyle}">
        <Setter Property="Data" Value="{StaticResource GeoWarning}" />
    </Style>

</ResourceDictionary>
