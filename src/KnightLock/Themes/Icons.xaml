                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:KnightLock.Controls">

    <!-- ============================== geometry ============================== -->
    <StreamGeometry x:Key="GeoFolder">F0 M3,6.4 A2.4,2.4 0 0 1 5.4,4 H9.2 L11.4,6.4 H18.6 A2.4,2.4 0 0 1 21,8.8 V17.6 A2.4,2.4 0 0 1 18.6,20 H5.4 A2.4,2.4 0 0 1 3,17.6 Z</StreamGeometry>

