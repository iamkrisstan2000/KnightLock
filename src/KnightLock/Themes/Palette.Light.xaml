<?xml version="1.0" encoding="utf-8"?>
<!--
  KnightLock — Fluent Design palette (Light)
  Values follow the Windows 11 WinUI 3 theme resources (TextFillColor*, CardBackgroundFill*, …)
  so the WPF shell matches native apps pixel-for-pixel.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Text -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush"       Color="#E4000000" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush"     Color="#9E000000" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush"      Color="#72000000" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush"  Color="#FFFFFFFF" />

    <!-- Accent -->
    <Color x:Key="AccentColor">#005FB8</Color>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush"   Color="#FF005FB8" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E6005FB8" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF003E92" />

    <!-- Cards & layers -->
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush"    Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush"  Color="#80F6F6F6" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush"            Color="#0F000000" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush"             Color="#80FFFFFF" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush"  Color="#F9F9F9" />

    <!-- Controls -->
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush"    Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush"  Color="#80F9F9F9" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush"   Color="#4DF9F9F9" />
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush"  Color="#14000000" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#29000000" />
    <SolidColorBrush x:Key="ControlStrokeColorOnAccentDefaultBrush" Color="#14000000" />

    <!-- Subtle (transparent buttons) -->
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush"   Color="#09000000" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush"    Color="#06000000" />

    <!-- Lines -->
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush"  Color="#0F000000" />
    <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush"  Color="#757575" />
    <SolidColorBrush x:Key="FocusStrokeColorOuterBrush"      Color="#E4000000" />

    <!-- System status -->
    <SolidColorBrush x:Key="SystemFillColorSuccessBrush"            Color="#FF0F7B0F" />
    <SolidColorBrush x:Key="SystemFillColorSuccessBackgroundBrush"  Color="#DFF6DD" />
    <SolidColorBrush x:Key="SystemFillColorCautionBrush"            Color="#FF9D5D00" />
    <SolidColorBrush x:Key="SystemFillColorCautionBackgroundBrush"  Color="#FFF7E9" />
    <SolidColorBrush x:Key="SystemFillColorCriticalBrush"           Color="#FFC42B1C" />

    <!-- Shell surfaces -->
    <SolidColorBrush x:Key="ShellBackdropBrush"       Color="#F3F3F3" />
    <!-- 3% wash over the system acrylic, which reads slightly too translucent on bright wallpapers -->
    <SolidColorBrush x:Key="AcrylicVeilBrush" Color="#08FFFFFF" />
    <SolidColorBrush x:Key="NavigationFillBrush"      Color="#40F3F3F3" />
    <SolidColorBrush x:Key="SmokeBrush"               Color="#4D000000" />
    <SolidColorBrush x:Key="DialogSurfaceBrush"       Color="#FFFFFFFF" />

    <!-- Brand -->
    <SolidColorBrush x:Key="BrandTintBrush" Color="#1A005FB8" />

</ResourceDictionary>
